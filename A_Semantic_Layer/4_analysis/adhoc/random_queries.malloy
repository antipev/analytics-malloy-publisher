
import '../../3_models/bridge_model.malloy'

-- full Join
run: bridge_model -> {
  group_by: products.Id
  aggregate: order_items.Order_Count
  having: order_items.Order_Count ~ f`0`
}

-- to select only from users table
run: bridge_model -> {
  group_by: users.Id
  aggregate: users.Total_Users
}
-- to select only from order table
run: bridge_model -> {
  group_by: order_items.User_id
  aggregate: order_items.Order_Count

}
-- to select only from order table JOINED with users table
run: bridge_model -> {
  group_by: order_items.User_Country
  aggregate: order_items.Order_Count

}
-- to select only from event table
run: bridge_model -> {
  group_by: events.User_id
  aggregate: events.`Count`

}
-- to select from all tables for User_id
run: bridge_model -> {
  group_by: `User_id`
  aggregate: order_items.Order_Count
  aggregate: events.`Count`
}
-- to select from all tables for User_id
run: bridge_model -> {
  group_by: `User_Country`
  aggregate: order_items.Order_Count
  aggregate: events.`Count`
}

